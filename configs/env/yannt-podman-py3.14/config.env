# Assume defined: PROJ_PATH, CONFIG_NAME, CONFIG_PATH

# ----- environment settings -----
export PY_VER=${PY_VER:-3.14}
export ENV_NAME=${ENV_NAME:-"yannt-podman-py${PY_VER}"}

# ----- podman settings -----
# Allow users to override podman runRoot, esp when project is on NFS mount.
export CRI_ROOT=${CRI_ROOT:-"${PROJ_PATH}/cache/podman/runroot"}
# Build our baseline podman command.
_CRI_BIN="podman --root ${CRI_ROOT}"
# Permit usage of podman without /etc/subuid or /etc/subgid
_CRI_BIN="${_CRI_BIN} --storage-opt overlay.ignore_chown_errors=true"
# Suppress annoying warnings.
_CRI_BIN="${_CRI_BIN} --cgroup-manager=cgroupfs"
# Allow users to specify container manager binary to use (e.g. docker/podman)
export CRI_BIN=${CRI_BIN:-"${_CRI_BIN}"}
# Allow users to specify where the project is mounted in the container.
export CRI_PROJ_PATH=${CRI_PROJ_PATH:-"/work"}
# Allow users to specify what is a "RUN" command when doing a "podman run" build.
export CRI_RUN=${CRI_RUN:-"${CRI_BIN} exec ${ENV_NAME}"}
# Allow users to specify "podman run" arguments (after build phase).
export CRI_RUN_ARGS=${CRI_RUN_ARGS:-"--userns=keep-id:uid=0,gid=0 -u 0:0"}
# Allow users to override home folder for container (relative to PROJ_PATH)
export CRI_HOME=${CRI_HOME:-"cache/podman/home"}

export APT_PKGS="graphviz flatbuffers-compiler protobuf-compiler cmake build-essential"

# ----- venv settings -----
export ROOT_DRIVE=${ROOT_DRIVE:-"/"}
export PYTHON_VENV_PREFIX=${PYTHON_VENV_PREFIX:-"cache/venv"}
export SYSTEM_PYTHON=${SYSTEM_PYTHON:-"python3"}
export VENV_PYTHON=${VENV_PYTHON:-"${PYTHON_VENV_PREFIX}/${ENV_NAME}/bin/python"}

# ----- python settings -----

PYTORCH_INDEX_URL="https://download.pytorch.org/whl/cpu"
PYPI_INDEX_URL="https://pypi.org/simple"
export PIP_IDX_ARGS=${PIP_IDX_ARGS:-"--index-url ${PYTORCH_INDEX_URL} --extra-index-url ${PYPI_INDEX_URL}"}
export PIP_UPSTREAM_VERIFIERS=${PIP_UPSTREAM_VERIFIERS:-"${PYTORCH_INDEX_URL} ${PYPI_INDEX_URL}"}

export PY_CONSTRAINTS=${PY_CONSTRAINTS:-configs/pyver/${PY_VER}/constraints-py${PY_VER}.txt}
export PY_REQS=${PY_REQS:-configs/pyver/${PY_VER}/requirements-py${PY_VER}.txt}
export PYTHON_PKG_PATH=${PYTHON_PKG_PATH:-"cache/pip_pkgs/${PY_VER}"}
export PYTHON_AUTOINSTALL_PATH=${PYTHON_AUTOINSTALL_PATH:-"configs/auto_install"}
export PKG_SKIP_LIST="thirdparty_yannt_naive_mnn"