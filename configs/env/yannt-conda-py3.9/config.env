# Assume defined: PROJ_PATH, CONFIG_NAME, CONFIG_PATH
export PY_VER=${PY_VER:-3.9}

export ENV_NAME=${ENV_NAME:-"yannt-conda-py${PY_VER}"}

# PY_CONSTRAINTS/PY_REQS should be relative to PROJ_PATH.
export PY_CONSTRAINTS=${PY_CONSTRAINTS:-configs/pyver/${PY_VER}/constraints-py${PY_VER}.txt}
export PY_REQS=${PY_REQS:-configs/pyver/${PY_VER}/requirements-py${PY_VER}.txt}

export ROOT_DRIVE=${ROOT_DRIVE:-"/"}
export PYTHON_PKG_PATH=${PYTHON_PKG_PATH:-"cache/pip_pkgs/${PY_VER}"}
export PYTHON_AUTOINSTALL_PATH=${PYTHON_AUTOINSTALL_PATH:-"configs/auto_install"}

export CONDA_PREFIX=${CONDA_PREFIX:-"cache/conda/envs"}
export CONDA_PYTHON=${CONDA_PYTHON:-"${CONDA_PREFIX}/${ENV_NAME}/bin"}

#export PYTHON_VENV_PREFIX=${PYTHON_VENV_PREFIX:-"cache/venv"}
#export PYTHON=${PYTHON:-"python3"}
#export VENV_PYTHON=${VENV_PYTHON:-"${PYTHON_VENV_PREFIX}/${ENV_NAME}/bin/python"}

export PKG_SKIP_LIST=""

if [ -z "$PIP_IDX_ARGS" ]; then
  PIP_IDX_ARGS="--index-url https://download.pytorch.org/whl/cpu"
  PIP_IDX_ARGS="$PIP_IDX_ARGS --extra-index-url https://pypi.org/simple"
  export PIP_IDX_ARGS
fi

export PIP_UPSTREAM_VERIFIERS=${PIP_UPSTREAM_VERIFIERS:-"https://download.pytorch.org/whl/cpu https://pypi.org/simple"}



