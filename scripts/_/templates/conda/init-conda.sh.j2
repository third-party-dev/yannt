# Create conda environment.
mkdir -p ${PROJ_PATH}/${CACHED_CONDA_PREFIX}
echo conda create -y -c defaults -c conda-forge -p ${PROJ_PATH}/${CACHED_CONDA_PREFIX}/${ENV_NAME} python=${PY_VER}
conda create -y -c defaults -c conda-forge \
  -p ${PROJ_PATH}/${CACHED_CONDA_PREFIX}/${ENV_NAME} python=${PY_VER} ${PIP_VERSION_SPEC}

