CONFIG_PATH=${CONFIG_PATH:-"{{config_path}}"}
CACHED_CONDA_PREFIX=${CONDA_PREFIX:="{{cached_conda_prefix}}"}

BUILDER_PATH=${BUILDER_PATH:-"{{builder_path}}"}
NEXT_INIT_TARGET=${NEXT_INIT_TARGET:-"{{next_init_target}}"}
PIP_VERSION_SPEC=${PIP_VERSION_SPEC:-"{{pip_version_spec}}"}

# ----- End Of Config -----

set -e

# -------- Initialize CONDA Environment ---------

# Attempt to activate conda
if [ -z "$(which conda)" ]; then
  echo "Could not locate conda. Please add conda to PATH."
  echo 
  echo "  Example: export PATH=\$PATH:/opt/conda/bin"
  echo
  echo "To install from upstream (~150M download and assuming write perms to /opt):"
  echo
  echo "  wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh"
  echo "  chmod +x Miniconda3-latest-Linux-x86_64.sh"
  echo "  ./Miniconda3-latest-Linux-x86_64.sh -b -p ./cache/conda/miniconda3"
  echo "  export PATH=\$PATH:$(pwd)/cache/conda/miniconda3/bin"
  echo
  exit 1
fi
