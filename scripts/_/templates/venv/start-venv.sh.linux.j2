#!/usr/bin/env bash

{{YOU_CAN_EDIT_THIS_FILE}}

set -e

# Assuming in top yannt path (PROJ_PATH)

export ENV_NAME=${ENV_NAME:-"{{env_name}}"}
export PYTHON_VENV_PREFIX=${PYTHON_VENV_PREFIX:-"{{python_venv_prefix}}"}

if [ $# -gt 0 ]; then

$@

else

echo
echo "The environment is now ready. Try 'yannt --help' for information."

# Include yannt tab completion.
TMP_RC="$(mktemp)"
cat >> "$TMP_RC" <<'EOF'
[ -f "$HOME/.bashrc" ] && source $HOME/.bashrc
source ${PYTHON_VENV_PREFIX}/${ENV_NAME}/bin/activate
eval "$(register-python-argcomplete yannt)"
EOF

exec bash --rcfile "$TMP_RC" -i

fi