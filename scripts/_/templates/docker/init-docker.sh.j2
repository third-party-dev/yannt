#!/usr/bin/env bash

{{YOU_CAN_EDIT_THIS_FILE}}

# Note: Assuming docker is always run from linux.

echo RUNNING $0

ENV_NAME=${ENV_NAME:-"{{env_name}}"}
PROJ_PATH=${PROJ_PATH:-"{{proj_path}}"}
CONFIG_NAME=${CONFIG_NAME:-"{{config_name}}"}
CONFIG_PATH=${CONFIG_PATH:-"{{config_path}}"}

CRI_BIN=${CRI_BIN:-"{{cri_bin}}"}
CRI_RUN=${CRI_RUN:-"{{cri_run}}"}
CRI_HOME=${CRI_HOME:-"{{cri_home}}"}
CRI_PROJ_PATH=${CRI_PROJ_PATH:-"{{cri_proj_path}}"}
CRI_RUN_ARGS=${CRI_RUN_ARGS:-"{{cri_run_args}}"}

APT_PKGS=${APT_PKGS:-"{{apt_packages}}"}

BUILDER_PATH=${BUILDER_PATH:-"{{builder_path}}"}
NEXT_INIT_TARGET=${NEXT_INIT_TARGET:-"{{next_init_target}}"}

# Construct the base container image (venv created from container runtime)
mkdir -p ${PROJ_PATH}/cache/empty-context
${CRI_BIN} build \
  -t localhost/${ENV_NAME} \
  -f ${PROJ_PATH}/${BUILDER_PATH}/init.dockerfile \
  ${PROJ_PATH}/cache/empty-context


# Continue within the container.

mkdir -p ${PROJ_PATH}/${CRI_HOME}
[ -z "${NEXT_INIT_TARGET}" ] || \
  ${CRI_BIN} run -ti --rm \
    -v ${PROJ_PATH}:${CRI_PROJ_PATH} -w ${CRI_PROJ_PATH} \
    -e USER="user" -e HOME=${CRI_PROJ_PATH}/${CRI_HOME} \
    -u $(id -u):$(id -g) ${CRI_RUN_ARGS} \
    localhost/${ENV_NAME} \
    ${CRI_PROJ_PATH}/${NEXT_INIT_TARGET}



