%% api-doc-template.latex
%% Pandoc LaTeX template for Python API documentation
%% Designed to produce clean, scannable PDF output from markdown
%% generated by an automated API documentation generator.
%%
%% Usage:
%%   pandoc input.md -o output.pdf --template=api-doc-template.latex \
%%          --pdf-engine=xelatex \
%%          -V title="My Library API" \
%%          -V version="1.0.0"
%%
%% Required packages (install via TeX Live / MikTeX):
%%   xelatex, fontspec, geometry, titlesec, fancyhdr, xcolor,
%%   hyperref, listings, mdframed, booktabs, longtable, array,
%%   enumitem, microtype, parskip, etoolbox, tocloft

\documentclass[$if(fontsize)$$fontsize$$else$10pt$endif$,$if(papersize)$$papersize$paper$else$a4paper$endif$,twoside]{article}

% ─── Core Packages ────────────────────────────────────────────────────────────
\usepackage{fontspec}
\usepackage[
  top=13mm, bottom=13mm,
  inner=15mm, outer=13mm,
  headheight=14pt
]{geometry}
\usepackage[table]{xcolor}
\usepackage{hyperref}
\usepackage{listings}
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}
\usepackage{multirow}
\usepackage{tabularx}
\usepackage{enumitem}
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{mdframed}
\usepackage{microtype}
\usepackage{parskip}
\usepackage{etoolbox}
\usepackage{tocloft}
\usepackage{graphicx}
\usepackage{float}
\floatplacement{figure}{H}
\raggedbottom
\usepackage{amsmath}
\usepackage{needspace}
\usepackage[normalem]{ulem}       % for \sout strikethrough in markdown
\usepackage{soul}                 % for \hl highlight

% ─── Fonts ────────────────────────────────────────────────────────────────────
% Default fonts: TeX Gyre family — ships in texlive-fonts-recommended,
% available on all Debian/Ubuntu systems without additional apt packages.
%   Pagella  = Palatino-based serif        → body text
%   Heros    = Helvetica-based sans-serif  → headings and labels
%   Cursor   = Courier-based monospace     → code blocks
%
% Override any of these at the pandoc command line with:
%   -V mainfont="My Serif" -V sansfont="My Sans" -V monofont="My Mono"
% or install your preferred fonts and edit the defaults below.
$if(mainfont)$
\setmainfont{$mainfont$}
$else$
\setmainfont{TeX Gyre Pagella}[Ligatures=TeX]
$endif$

$if(sansfont)$
\setsansfont{$sansfont$}
$else$
\setsansfont{TeX Gyre Heros}[Ligatures=TeX]
$endif$

$if(monofont)$
\setmonofont{$monofont$}
$else$
\setmonofont{TeX Gyre Cursor}[Scale=0.92]
$endif$

% ─── Colour Palette ──────────────────────────────────────────────────────────
\definecolor{ApiBlue}      {HTML}{1a5276}   % namespace headings
\definecolor{ApiTeal}      {HTML}{117a65}   % member headings
\definecolor{ApiGray}      {HTML}{5d6d7e}   % qualified names / small text
\definecolor{ApiLightGray} {HTML}{f2f3f4}   % code background
\definecolor{ApiRuleHeavy} {HTML}{1a5276}   % thick namespace separator
\definecolor{ApiRuleLight} {HTML}{aab7b8}   % thin member separator
\definecolor{ApiLink}      {HTML}{2e4057}   % hyperlinks
\definecolor{ApiKeyword}   {HTML}{7d3c98}   % code keywords
\definecolor{ApiString}    {HTML}{1e8449}   % code strings
\definecolor{ApiComment}   {HTML}{909090}   % code comments
\definecolor{ApiNumber}    {HTML}{d35400}   % code numbers
\definecolor{ApiBuiltin}   {HTML}{1a5276}   % code builtins
\definecolor{TableHead}    {HTML}{2c3e50}   % table header background
\definecolor{TableOdd}     {HTML}{ffffff}   % table odd row
\definecolor{TableEven}    {HTML}{f8f9fa}   % table even row

% ─── Hyperref Setup ──────────────────────────────────────────────────────────
\hypersetup{
  colorlinks  = true,
  linkcolor   = ApiLink,
  urlcolor    = ApiBlue,
  citecolor   = ApiTeal,
  pdftitle    = {$if(title)$$title$$endif$},
  pdfauthor   = {$if(author)$$for(author)$$author$$sep$, $endfor$$endif$},
  pdfsubject  = {API Reference},
  pdfkeywords = {$if(keywords)$$for(keywords)$$keywords$$sep$, $endfor$$endif$},
  bookmarks   = true,
  bookmarksnumbered = false,
  bookmarksopen = true,
  pdfpagemode = UseOutlines,
  unicode     = true
}

% ─── Section / Heading Styles ─────────────────────────────────────────────────
%
%  Heading hierarchy for API docs:
%    H1  (#)    = Namespace (class, module)       — large, ApiBlue, preceded by thick rule
%    H2  (##)   = Section labels (Methods, Attrs) — medium, ApiGray, small caps
%    H3  (###)  = Sub-namespace or grouping       — medium, ApiBlue
%    H4  (####) = Individual member               — bold monospace, ApiTeal
%    H5  (#####)= Rarely used; sub-member detail  — italic, ApiGray

% Namespace heading (H1)
\titleformat{\section}
  {\color{ApiBlue}\fontsize{20}{24}\sffamily\bfseries}
  {}
  {0pt}
  {}
  []

\titlespacing*{\section}{0pt}{6pt}{4pt}

% Section label heading (H2) — "Methods", "Attributes", etc.
\titleformat{\subsection}
  {\color{ApiGray}\fontsize{12}{15}\sffamily\bfseries\MakeUppercase}
  {}
  {0pt}
  {}
  []

\titlespacing*{\subsection}{0pt}{14pt}{4pt}

% Sub-namespace / grouping (H3)
\titleformat{\subsubsection}
  {\color{ApiBlue}\fontsize{13}{16}\sffamily\bfseries}
  {}
  {0pt}
  {}
  []

\titlespacing*{\subsubsection}{0pt}{10pt}{3pt}

% Individual member heading (H4)
\titleformat{\paragraph}[hang]
  {\color{ApiTeal}\fontsize{11}{14}\ttfamily\bfseries}
  {}
  {0pt}
  {}
  []

\titlespacing*{\paragraph}{0pt}{10pt}{3pt}

% Sub-member detail (H5)
\titleformat{\subparagraph}[hang]
  {\color{ApiGray}\fontsize{10}{13}\sffamily\itshape}
  {}
  {0pt}
  {}
  []

\titlespacing*{\subparagraph}{0pt}{6pt}{2pt}

% ─── Horizontal Rules (namespace-rule vs member-rule) ─────────────────────────
%
% Pandoc converts <hr> to \rule or a native horizontal rule.
% We redefine \HorizontalRule to intercept, but Pandoc actually emits:
%   \begin{center}\rule{0.5\linewidth}{0.5pt}\end{center}
%
% We patch \rule within that context by redefining the hr output.
% The cleanest approach is a Lua filter (see api-doc-filter.lua), but
% as a fallback we override \hrule and the center-rule pattern here.

% Heavy rule — used before namespace (H1) blocks via raw LaTeX in markdown:
%   <div class="namespace-rule"></div>   → Lua filter → \namespaceRule{}
\newcommand{\namespaceRule}{%
  \vspace{8pt}%
  {\color{ApiRuleHeavy}\rule{\linewidth}{2.5pt}}%
  \vspace{2pt}%
}

% Light rule — used between members via:
%   <div class="member-rule"></div>   → Lua filter → \memberRule{}
\newcommand{\memberRule}{%
  \vspace{4pt}%
  {\color{ApiRuleLight}\rule{\linewidth}{0.6pt}}%
  \vspace{4pt}%
}

% Default pandoc <hr> → light rule (fallback if Lua filter is absent)
\providecommand{\horizontalrule}{}
\renewcommand{\horizontalrule}{%
  \vspace{4pt}%
  {\color{ApiRuleLight}\rule{\linewidth}{0.6pt}}%
  \vspace{4pt}%
}

% ─── Qualified-Name / Small-Text Style ───────────────────────────────────────
%
% Pandoc converts <small>...</small> to \small{} in LaTeX.
% We enhance it with our gray monospace style.
\let\oldsmall\small
\renewcommand{\small}{\color{ApiGray}\footnotesize\ttfamily}

% ─── Code Listings ────────────────────────────────────────────────────────────
\lstdefinelanguage{PythonEnhanced}{
  language     = Python,
  morekeywords = {
    self, cls, None, True, False,
    async, await, yield, from, import, as,
    dataclass, property, classmethod, staticmethod,
    overload, final, Protocol, TypeVar, Generic,
    Optional, Union, List, Dict, Set, Tuple, Any,
    Callable, Iterator, Generator, AsyncIterator
  },
  sensitive    = true
}

\lstdefinestyle{ApiCode}{
  language         = PythonEnhanced,
  backgroundcolor  = \color{ApiLightGray},
  basicstyle       = \ttfamily\small\color{black},
  keywordstyle     = \color{ApiKeyword}\bfseries,
  stringstyle      = \color{ApiString},
  commentstyle     = \color{ApiComment}\itshape,
  numberstyle      = \color{ApiNumber},
  emphstyle        = \color{ApiBuiltin}\bfseries,
  showstringspaces = false,
  breaklines       = true,
  breakatwhitespace= true,
  breakindent      = 2em,
  columns          = flexible,
  keepspaces       = true,
  frame            = single,
  framerule        = 0.4pt,
  rulecolor        = \color{ApiRuleLight},
  framesep         = 4pt,
  xleftmargin      = 6pt,
  xrightmargin     = 6pt,
  aboveskip        = 6pt,
  belowskip        = 6pt,
  tabsize          = 4,
  literate         =
    {á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
    {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1
    {à}{{\`a}}1 {è}{{\`e}}1 {ì}{{\`i}}1 {ò}{{\`o}}1 {ù}{{\`u}}1
    {ü}{{\"u}}1 {ö}{{\"o}}1 {ä}{{\"a}}1 {ë}{{\"e}}1
    {→}{{{\(\rightarrow\)}}}1 {←}{{{\(\leftarrow\)}}}1
    {≤}{{{\(\leq\)}}}1 {≥}{{{\(\geq\)}}}1 {≠}{{{\(\neq\)}}}1
}

% Inline code style (backtick spans)
\lstdefinestyle{ApiInline}{
  language         = PythonEnhanced,
  basicstyle       = \ttfamily\small\color{ApiBlue},
  backgroundcolor  = \color{ApiLightGray},
  breaklines       = false,
  columns          = fixed,
  keepspaces       = true
}

% fvextra extends fancyvrb with line-breaking; must load before highlighting-macros
% so that pandoc's Verbatim environment inherits breaklines support.
\usepackage{fvextra}
\fvset{breaklines=true,breakanywhere=false}

% Wire up pandoc code blocks to our style
$if(highlighting-macros)$
$highlighting-macros$
$endif$

% Override Shaded environment (used by pandoc's syntax highlighting)
% Shaded is defined by pandoc's --highlight-style; we redefine it if present,
% or define it fresh if not (e.g. when compiling without syntax highlighting).
\definecolor{shadecolor}{HTML}{f2f3f4}
\ifcsname Shaded\endcsname
  \renewenvironment{Shaded}{%
    \begin{mdframed}[
      backgroundcolor  = ApiLightGray,
      linecolor        = ApiRuleLight,
      linewidth        = 0.4pt,
      innerleftmargin  = 6pt,
      innerrightmargin = 6pt,
      innertopmargin   = 4pt,
      innerbottommargin= 4pt,
      skipabove        = 6pt,
      skipbelow        = 6pt
    ]%
  }{\end{mdframed}}
\else
  \newenvironment{Shaded}{%
    \begin{mdframed}[
      backgroundcolor  = ApiLightGray,
      linecolor        = ApiRuleLight,
      linewidth        = 0.4pt,
      innerleftmargin  = 6pt,
      innerrightmargin = 6pt,
      innertopmargin   = 4pt,
      innerbottommargin= 4pt,
      skipabove        = 6pt,
      skipbelow        = 6pt
    ]%
  }{\end{mdframed}}
\fi

% ─── Tables ───────────────────────────────────────────────────────────────────
% Pandoc generates longtable for pipe tables; we style it here.
\setlength{\defaultaddspace}{0pt}

% Left-justify all longtables (default is centred via \LTleft=\fill, \LTright=\fill)
\setlength{\LTleft}{0pt}
\setlength{\LTright}{\fill}

% Header row background
\newcommand{\tableheadstyle}{%
  \rowcolor{TableHead}%
  \color{white}\sffamily\bfseries\small
}

% Alternating row colours: enabled by xcolor [table] option above.
% The Lua filter sets \rowcolor explicitly per row, so this is a safety fallback.
\AtBeginDocument{%
  \rowcolors{2}{TableOdd}{TableEven}%
}

% Column type for wrapping text in tables
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}

% ─── Lists ────────────────────────────────────────────────────────────────────
% Tighter lists for docstring sections (Args, Returns, etc.)
% \tightlist is emitted by pandoc for compact lists (no blank lines between items)
\providecommand{\tightlist}{%
  \setlength{\itemsep}{2pt}\setlength{\parskip}{0pt}}

\setlist[itemize]{
  leftmargin  = 1.4em,
  itemsep     = 2pt,
  parsep      = 0pt,
  topsep      = 3pt,
  partopsep   = 0pt
}

\setlist[enumerate]{
  leftmargin  = 1.4em,
  itemsep     = 2pt,
  parsep      = 0pt,
  topsep      = 3pt,
  partopsep   = 0pt
}

% ─── Headers & Footers ────────────────────────────────────────────────────────
\pagestyle{fancy}
\fancyhf{}

\fancyhead[LE]{\small\color{ApiGray}\sffamily $if(title)$$title$$endif$$if(version)$\ \textbf{$version$}$endif$}
\fancyhead[RO]{\small\color{ApiGray}\sffamily\leftmark}
\fancyfoot[LE,RO]{\small\color{ApiGray}\thepage}
\fancyfoot[RE,LO]{\small\color{ApiGray}\sffamily API Reference}

\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\color{ApiRuleLight}\hrule width\headwidth height\headrulewidth}
\renewcommand{\footrulewidth}{0pt}

% Plain style for first pages of sections
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[LE,RO]{\small\color{ApiGray}\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
}

% ─── Table of Contents ────────────────────────────────────────────────────────
\setcounter{tocdepth}{4}
\setcounter{secnumdepth}{0}   % suppress auto section numbers in TOC and headings
\renewcommand{\cfttoctitlefont}{\color{ApiBlue}\Large\sffamily\bfseries}
\renewcommand{\cftaftertoctitle}{\\\color{ApiRuleHeavy}\rule{\linewidth}{2pt}}
\renewcommand{\cftsecfont}{\large\sffamily\bfseries\color{ApiBlue}}
\renewcommand{\cftsecpagefont}{\large\sffamily\color{ApiGray}}
\setlength{\cftbeforesecskip}{7pt}
\setlength{\cftbeforesubsecskip}{7pt}
\setlength{\cftbeforesubsubsecskip}{2pt}
\setlength{\cftbeforeparaskip}{2pt}
\renewcommand{\cftsubsecfont}{\sffamily\bfseries\color{ApiGray}}
\renewcommand{\cftsubsecpagefont}{\sffamily\color{ApiGray}}
\renewcommand{\cftsubsubsecfont}{\sffamily\color{ApiTeal}}
\renewcommand{\cftsubsubsecpagefont}{\sffamily\small\color{ApiGray}}
\renewcommand{\cftparafont}{\sffamily\small\itshape\color{ApiGray}}
\renewcommand{\cftparapagefont}{\sffamily\small\color{ApiGray}}

% ─── Document Metadata ────────────────────────────────────────────────────────
\title{%
  {\color{ApiBlue}\Huge\sffamily\bfseries $if(title)$$title$$else$API Reference$endif$}%
  $if(subtitle)$\\[4pt]{\color{ApiGray}\large\sffamily $subtitle$}$endif$%
  $if(version)$\\[6pt]{\color{ApiGray}\normalsize\sffamily\ttfamily Version $version$}$endif$%
}

\author{%
  $if(author)$
  $for(author)$
  {\sffamily $author$}$sep$\\
  $endfor$
  $endif$
}

\date{$if(date)${\sffamily\color{ApiGray} $date$}$endif$}

% ─── Document Body ────────────────────────────────────────────────────────────
\begin{document}

$if(has-frontmatter)$
\frontmatter
$endif$

% Title page
\maketitle
\thispagestyle{empty}

$if(abstract)$
\begin{mdframed}[
  backgroundcolor = ApiLightGray,
  linecolor       = ApiBlue,
  linewidth       = 1pt,
  innerleftmargin = 10pt,
  innerrightmargin= 10pt,
  innertopmargin  = 8pt,
  innerbottommargin=8pt
]
{\sffamily\bfseries\color{ApiBlue}Overview}\\[4pt]
$abstract$
\end{mdframed}
\vspace{8pt}
$endif$

$for(include-before)$
$include-before$
$endfor$

$if(toc)$
\clearpage
\tableofcontents
\clearpage
$endif$

$if(lot)$
\listoftables
$endif$

$if(lof)$
\listoffigures
$endif$

$if(linestretch)$
\setstretch{$linestretch$}
$endif$

$if(has-frontmatter)$
\mainmatter
$endif$

% ─── Main Content ─────────────────────────────────────────────────────────────
$body$

$if(has-frontmatter)$
\backmatter
$endif$

$for(include-after)$
$include-after$
$endfor$

\end{document}
